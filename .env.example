# Supabase — ambil dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Opsional: hanya dipakai oleh script seeding (scripts/seed.mjs), JANGAN pernah
# expose service role key ke browser / commit ke git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Catatan: bucket Storage "kemutnews-media" (untuk upload gambar dari Admin
# Panel) dibuat otomatis saat kamu menjalankan supabase/schema.sql.
